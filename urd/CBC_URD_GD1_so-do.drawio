ap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="242.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c18" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="445" as="sourcePoint"/><mxPoint x="66" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="2. Soạn nội dung bản tin tự do" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="382.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c20" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="585" as="sourcePoint"/><mxPoint x="66" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="3. Thiết lập tiêu đề bản tin theo cấp và cơ quan ra lệnh" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="522.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c22" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="725" as="sourcePoint"/><mxPoint x="66" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="4. Soạn bản tin tiếng Việt có dấu hoặc không dấu" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="662.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c24" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="865" as="sourcePoint"/><mxPoint x="66" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="5. Tự tính số trang CB, ghép nhiều trang cho bản tin dài" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="802.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c26" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="1005" as="sourcePoint"/><mxPoint x="66" y="1005" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="6. Cho phép chèn đường link (https://…) trong nội dung" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="942.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c28" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="1145" as="sourcePoint"/><mxPoint x="66" y="1145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="7. Chọn vùng phát theo mã hành chính Tỉnh/Xã" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="1082.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c30" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="1285" as="sourcePoint"/><mxPoint x="66" y="1285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="8. Tự động xác định danh sách Cell ID theo vùng phát đã chọn" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="1222.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c32" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="1425" as="sourcePoint"/><mxPoint x="66" y="1425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="9. Phát bản tin tới mạng 4G" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="1362.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c34" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="1565" as="sourcePoint"/><mxPoint x="66" y="1565" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="10. Chọn mức độ ưu tiên cho bản tin theo bảng CMAS (mặc định thiên tai: Cảnh báo Khẩn cấp Quốc gia)" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="66.0" y="1502.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c36" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="228" as="sourcePoint"/><mxPoint x="420" y="1425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="305" as="sourcePoint"/><mxPoint x="440" y="305" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="11. Cấu hình chu kỳ lặp phát 5–300 giây (mặc định 15–20 giây)" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="440.0" y="242.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c39" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="445" as="sourcePoint"/><mxPoint x="440" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="12. Cấu hình thời hạn phát 15 phút – 48 giờ" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="440.0" y="382.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c41" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="585" as="sourcePoint"/><mxPoint x="440" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="13. Xem trước bản tin hiển thị trên điện thoại (iPhone/Android)" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="440.0" y="522.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c43" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="725" as="sourcePoint"/><mxPoint x="440" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="14. Phê duyệt bản tin, xác thực OTP trước khi phát" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="440.0" y="662.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c45" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="865" as="sourcePoint"/><mxPoint x="440" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="15. Gửi lệnh phát xuống MME/AMF sau khi phê duyệt" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="440.0" y="802.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c47" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="1005" as="sourcePoint"/><mxPoint x="440" y="1005" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="16. Cập nhật bản tin đang phát bằng cách tăng Serial Number" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="440.0" y="942.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c49" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="1145" as="sourcePoint"/><mxPoint x="440" y="1145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="17. Dừng bản tin đang phát theo yêu cầu" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="440.0" y="1082.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c51" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="1285" as="sourcePoint"/><mxPoint x="440" y="1285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="18. Phát lại bản tin sau khi dừng" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="440.0" y="1222.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c53" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="1425" as="sourcePoint"/><mxPoint x="440" y="1425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="19. Hẹn giờ phát bản tin" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="440.0" y="1362.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c55" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="794" y="214" as="sourcePoint"/><mxPoint x="794" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="794" y="305" as="sourcePoint"/><mxPoint x="814" y="305" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="1. Tra cứu danh sách bản tin (tìm kiếm, lọc)" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="814.0" y="242.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c58" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="794" y="445" as="sourcePoint"/><mxPoint x="814" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="2. Ghi nhận kết quả phát theo từng cell" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="814.0" y="382.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c60" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="794" y="585" as="sourcePoint"/><mxPoint x="814" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="3. Báo cáo tổng quan chiến dịch (thông tin chiến dịch, tỷ lệ kích hoạt trạm, danh sách Cell ID)" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="814.0" y="522.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c62" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="794" y="725" as="sourcePoint"/><mxPoint x="814" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="4. Xuất báo cáo ra file" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="814.0" y="662.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c64" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1168" y="214" as="sourcePoint"/><mxPoint x="1168" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c65" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1168" y="305" as="sourcePoint"/><mxPoint x="1188" y="305" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c66" value="1. Quản lý thư viện 50 mẫu tin chuẩn theo 5 nhóm tình huống, có trường biến" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1188.0" y="242.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c67" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1168" y="445" as="sourcePoint"/><mxPoint x="1188" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c68" value="2. Quản lý danh mục mức độ ưu tiên (bảng CMAS)" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1188.0" y="382.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c69" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1168" y="585" as="sourcePoint"/><mxPoint x="1188" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value="3. Tra cứu danh mục Tỉnh/Xã" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1188.0" y="522.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c71" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1168" y="725" as="sourcePoint"/><mxPoint x="1188" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c72" value="4. Quản lý dữ liệu ánh xạ Xã - Cell ID" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1188.0" y="662.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c73" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1168" y="865" as="sourcePoint"/><mxPoint x="1188" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c74" value="5. Cấu hình tham số phát mặc định" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1188.0" y="802.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c75" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1542" y="214" as="sourcePoint"/><mxPoint x="1542" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c76" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1542" y="305" as="sourcePoint"/><mxPoint x="1562" y="305" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c77" value="1. Đăng nhập CMS có xác thực OTP" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1562.0" y="242.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c78" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1542" y="445" as="sourcePoint"/><mxPoint x="1562" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c79" value="2. Quản lý tài khoản người dùng" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1562.0" y="382.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c80" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1542" y="585" as="sourcePoint"/><mxPoint x="1562" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c81" value="3. Phân quyền 2 vai trò: Người soạn thảo, Người phê duyệt" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1562.0" y="522.0" width="304.0" height="126.0" as="geometry"/></mxCell><mxCell id="c82" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1542" y="725" as="sourcePoint"/><mxPoint x="1562" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c83" value="4. Ghi nhật ký thao tác hệ thống" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1562.0" y="662.0" width="304.0" height="126.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h3" name="Hình 3. Module Phát tin cảnh báo"><mxGraphModel dx="1220" dy="1248" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="1248" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;MODULE PHÁT TIN CẢNH BÁO&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;spacing=6;html=1;fillColor=#5BC8F0;strokeColor=#2A6F8F;strokeWidth=1.6;fontFamily=Arial;fontSize=22;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="50.0" y="20.0" width="1140.0" height="74.0" as="geometry"/></mxCell><mxCell id="c3" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="94" as="sourcePoint"/><mxPoint x="450" y="134" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="134" as="sourcePoint"/><mxPoint x="850" y="134" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="134" as="sourcePoint"/><mxPoint x="50" y="1153" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="229" as="sourcePoint"/><mxPoint x="74" y="229" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="1. Tạo bản tin từ thư viện mẫu, nhập giá trị các biến" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="74.0" y="164.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c8" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="383" as="sourcePoint"/><mxPoint x="74" y="383" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="2. Soạn nội dung bản tin tự do" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="74.0" y="318.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c10" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="537" as="sourcePoint"/><mxPoint x="74" y="537" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="3. Thiết lập tiêu đề bản tin theo cấp và cơ quan ra lệnh" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="74.0" y="472.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="691" as="sourcePoint"/><mxPoint x="74" y="691" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="4. Soạn bản tin tiếng Việt có dấu hoặc không dấu" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="74.0" y="626.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c14" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="845" as="sourcePoint"/><mxPoint x="74" y="845" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="5. Tự tính số trang CB, ghép nhiều trang cho bản tin dài" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="74.0" y="780.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c16" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="999" as="sourcePoint"/><mxPoint x="74" y="999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="6. Cho phép chèn đường link (https://…) trong nội dung" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="74.0" y="934.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c18" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="1153" as="sourcePoint"/><mxPoint x="74" y="1153" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="7. Chọn vùng phát theo mã hành chính Tỉnh/Xã" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="74.0" y="1088.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c20" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="134" as="sourcePoint"/><mxPoint x="450" y="999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="229" as="sourcePoint"/><mxPoint x="474" y="229" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="8. Tự động xác định danh sách Cell ID theo vùng phát đã chọn" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="474.0" y="164.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c23" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="383" as="sourcePoint"/><mxPoint x="474" y="383" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="9. Phát bản tin tới mạng 4G" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="474.0" y="318.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c25" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="537" as="sourcePoint"/><mxPoint x="474" y="537" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="10. Chọn mức độ ưu tiên cho bản tin theo bảng CMAS (mặc định thiên tai: Cảnh báo Khẩn cấp Quốc gia)" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="474.0" y="472.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c27" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="691" as="sourcePoint"/><mxPoint x="474" y="691" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="11. Cấu hình chu kỳ lặp phát 5–300 giây (mặc định 15–20 giây)" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="474.0" y="626.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c29" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="845" as="sourcePoint"/><mxPoint x="474" y="845" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="12. Cấu hình thời hạn phát 15 phút – 48 giờ" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="474.0" y="780.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c31" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="999" as="sourcePoint"/><mxPoint x="474" y="999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="13. Xem trước bản tin hiển thị trên điện thoại (iPhone/Android)" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="474.0" y="934.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c33" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="134" as="sourcePoint"/><mxPoint x="850" y="999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="229" as="sourcePoint"/><mxPoint x="874" y="229" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="14. Phê duyệt bản tin, xác thực OTP trước khi phát" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="874.0" y="164.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c36" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="383" as="sourcePoint"/><mxPoint x="874" y="383" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="15. Gửi lệnh phát xuống MME/AMF sau khi phê duyệt" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A6F8F;strokeWidth=1.2;fontFamily=Arial;fontSize=21;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="874.0" y="318.0" width="316.0" height="130.0" as="geometry"/></mxCell><mxCell id="c38" style="edgeStyle=none;html=1;rounded=0;endArrow=none;startArrow=none;endSize=8;startSize=6;strokeColor=#222222;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="537" as="sourcePoint"/><mxPoint x="874" y="537" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="16. Cập nhật bản tin đang phát bằng cách tăng Serial Number" style="rounded=0;whiteSpace=wrap;spacing=6;html=1;fillColor=#B9E8FA;strokeColor=#2A