<mxfile host="app.diagrams.net" type="device"><diagram id="srs0" name="SRS-H1 Kiến trúc tổng quan"><mxGraphModel dx="1720" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0" value="&lt;b&gt;Hình 1. Sơ đồ kiến trúc tổng quan hệ thống CBC&lt;/b&gt;" style="text;html=1;fontFamily=Times New Roman;fontSize=22;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="bd" value="&lt;b&gt;RANH GIỚI HỆ THỐNG CBC (System Boundary)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=19;fillColor=#F4FBFE;strokeColor=#1F6FB2;strokeWidth=1.3;align=center;verticalAlign=top;spacing=8;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="800" height="690" as="geometry"/></mxCell><mxCell id="cms" value="&lt;b&gt;Lớp giao diện: Cổng vận hành CMS (web, HTTPS)&lt;/b&gt;&lt;br&gt;Đăng nhập + OTP, soạn tin, phê duyệt, theo dõi, báo cáo, danh mục, quản trị" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="720" height="90" as="geometry"/></mxCell><mxCell id="core" value="&lt;b&gt;Lớp nghiệp vụ&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#C9EEFB;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="260" width="720" height="330" as="geometry"/></mxCell><mxCell id="m0" value="&lt;b&gt;Truy cập và điều hướng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đăng nhập + OTP&lt;br&gt;Đổi mật khẩu&lt;br&gt;Đăng xuất, hết phiên&lt;br&gt;Trang tổng quan&lt;br&gt;Menu theo quyền" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=17;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="455" y="300" width="133" height="275" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;Quản lý bản tin&lt;/b&gt;&lt;br&gt;&lt;br&gt;Soạn (mẫu / tự do)&lt;br&gt;Chọn vùng phát Tỉnh/Xã → Cell&lt;br&gt;Gửi duyệt, phê duyệt + OTP&lt;br&gt;Phát, hẹn giờ&lt;br&gt;Cập nhật, dừng, phát lại" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=17;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="596" y="300" width="133" height="275" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;Theo dõi và báo cáo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tra cứu bản tin&lt;br&gt;Kết quả theo cell&lt;br&gt;Báo cáo chiến dịch&lt;br&gt;Xuất báo cáo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=17;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="737" y="300" width="133" height="275" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;Quản lý danh mục&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mẫu tin&lt;br&gt;Mức ưu tiên CMAS&lt;br&gt;Tỉnh/Xã&lt;br&gt;Ánh xạ Xã – Cell&lt;br&gt;Tham số phát" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=17;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="878" y="300" width="133" height="275" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;Quản trị người dùng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tài khoản&lt;br&gt;Phân quyền&lt;br&gt;Nhật ký" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=17;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1019" y="300" width="133" height="275" as="geometry"/></mxCell><mxCell id="net" value="&lt;b&gt;Kết nối mạng&lt;/b&gt;&lt;br&gt;gửi lệnh phát, cập nhật, dừng tới MME (chuẩn 3GPP); nhận kết quả theo cell" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="620" width="350" height="100" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Cơ sở dữ liệu&lt;/b&gt;&lt;br&gt;bản tin, Tỉnh/Xã – Cell, mẫu tin, người dùng, nhật ký" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="810" y="620" width="350" height="100" as="geometry"/></mxCell><mxCell id="so" value="&lt;b&gt;Người soạn thảo&lt;/b&gt;&lt;br&gt;(VinaPhone)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#FFF6D6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="300" height="64" as="geometry"/></mxCell><mxCell id="pd" value="&lt;b&gt;Người phê duyệt&lt;/b&gt;&lt;br&gt;(VinaPhone)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#FFF6D6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="300" height="64" as="geometry"/></mxCell><mxCell id="qt" value="&lt;b&gt;Quản trị hệ thống&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#FFF6D6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="300" height="64" as="geometry"/></mxCell><mxCell id="cq" value="&lt;b&gt;Cơ quan chức năng&lt;/b&gt;&lt;br&gt;(BCĐ PCTT, Cục Viễn thông…)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#F3F4F6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="300" height="100" as="geometry"/></mxCell><mxCell id="srs0e2" value="HTTPS" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="so" target="cms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srs0e3" value="HTTPS + OTP" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pd" target="cms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="272"/><mxPoint x="370" y="185"/></Array></mxGeometry></mxCell><mxCell id="srs0e4" value="HTTPS" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="qt" target="cms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="372"/><mxPoint x="385" y="212"/></Array></mxGeometry></mxCell><mxCell id="srs0e5" value="GĐ1: công văn" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cq" target="so"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="15" y="670"/><mxPoint x="15" y="172"/></Array></mxGeometry></mxCell><mxCell id="srs0e6" value="GĐ sau: API" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="cq" target="core"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="650"/><mxPoint x="380" y="557"/></Array></mxGeometry></mxCell><mxCell id="mme" value="&lt;b&gt;MME&lt;/b&gt;&lt;br&gt;(mạng VNPT Net)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#F3F4F6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="560" width="300" height="90" as="geometry"/></mxCell><mxCell id="enb" value="&lt;b&gt;Trạm 4G (cell)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#F3F4F6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="700" width="300" height="60" as="geometry"/></mxCell><mxCell id="ue" value="&lt;b&gt;Thiết bị người dân&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#F3F4F6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="810" width="300" height="60" as="geometry"/></mxCell><mxCell id="amf" value="&lt;b&gt;AMF (5G)&lt;/b&gt;&lt;br&gt;GĐ sau" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#F3F4F6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="440" width="300" height="70" as="geometry"/></mxCell><mxCell id="sms" value="&lt;b&gt;Hệ thống gửi SMS&lt;/b&gt;&lt;br&gt;(VinaPhone)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#F3F4F6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="140" width="300" height="80" as="geometry"/></mxCell><mxCell id="cell" value="&lt;b&gt;Nguồn dữ liệu Tỉnh – Xã – Cell&lt;/b&gt;&lt;br&gt;(VNPT Net)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#F3F4F6;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="290" width="300" height="90" as="geometry"/></mxCell><mxCell id="srs0e7" value="OTP &lt;i style=&quot;color:#C05000&quot;&gt;[Cần xác nhận]&lt;/i&gt;" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cms" target="sms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="185"/><mxPoint x="1270" y="180"/></Array></mxGeometry></mxCell><mxCell id="srs0e8" value="Tỉnh, Xã, trạm, Cell ID&lt;br&gt;(cách lấy &lt;i style=&quot;color:#C05000&quot;&gt;[Cần xác nhận]&lt;/i&gt;)" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="cell" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srs0e9" value="Lệnh phát / Kết quả theo cell" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="net" target="mme"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="750"/><mxPoint x="1290" y="750"/><mxPoint x="1290" y="605"/></Array></mxGeometry></mxCell><mxCell id="srs0e10" value="GĐ sau" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="net" target="amf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="605"/><mxPoint x="1250" y="605"/><mxPoint x="1250" y="475"/></Array></mxGeometry></mxCell><mxCell id="srs0e11" value="Lệnh phát" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mme" target="enb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srs0e12" value="Phát quảng bá" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=block;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="enb" target="ue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lg0" value="&lt;b&gt;Chú thích:&lt;/b&gt; khung nét đứt xanh = ranh giới hệ thống CBC; nét đứt = giai đoạn sau hoặc không kết nối trực tiếp. Khung vàng = người dùng; khung xám = ngoài CBC. GĐ1 chỉ phát mạng 4G." style="text;html=1;fontFamily=Times New Roman;fontSize=17;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1560" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="srs4" name="SRS-H2 Phân rã chức năng"><mxGraphModel dx="1760" dy="290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="290" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t4" value="&lt;b&gt;Hình 2. Sơ đồ phân rã tổng quan hệ thống CBC – giai đoạn 1&lt;/b&gt;" style="text;html=1;fontFamily=Times New Roman;fontSize=22;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell><mxCell id="root" value="&lt;b&gt;HỆ THỐNG CBC – GIAI ĐOẠN 1&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#C9EEFB;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="630" y="70" width="500" height="60" as="geometry"/></mxCell><mxCell id="m0" value="&lt;b&gt;1. Truy cập và điều hướng&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#DCEBFA;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="310" height="64" as="geometry"/></mxCell><mxCell id="srs4e2" value="" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=none;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="m0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="155"/><mxPoint x="195" y="155"/></Array></mxGeometry></mxCell><mxCell id="m1" value="&lt;b&gt;2. Quản lý bản tin&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#DCEBFA;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="310" height="64" as="geometry"/></mxCell><mxCell id="srs4e3" value="" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=none;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="155"/><mxPoint x="535" y="155"/></Array></mxGeometry></mxCell><mxCell id="m2" value="&lt;b&gt;3. Theo dõi và báo cáo&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#DCEBFA;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="310" height="64" as="geometry"/></mxCell><mxCell id="srs4e4" value="" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=none;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="m2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="155"/><mxPoint x="875" y="155"/></Array></mxGeometry></mxCell><mxCell id="m3" value="&lt;b&gt;4. Quản lý danh mục&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#DCEBFA;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="310" height="64" as="geometry"/></mxCell><mxCell id="srs4e5" value="" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=none;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="m3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="155"/><mxPoint x="1215" y="155"/></Array></mxGeometry></mxCell><mxCell id="m4" value="&lt;b&gt;5. Quản trị người dùng&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fillColor=#DCEBFA;strokeColor=#333333;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="180" width="310" height="64" as="geometry"/></mxCell><mxCell id="srs4e6" value="" style="html=1;fontFamily=Times New Roman;fontSize=16;endArrow=none;startArrow=none;endFill=1;strokeColor=#333333;strokeWidth=1.3;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="m4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="155"/><mxPoint x="1555" y="155"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="srs2" name="SRS-H3 Dữ liệu"><mxGraphModel dx="1780" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="&lt;b&gt;Hình 3. Sơ đồ quan hệ thực thể (thuộc tính chính)&lt;/b&gt;" style="text;html=1;fontFamily=Times New Roman;fontSize=18;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="tinh" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Tỉnh&lt;/div&gt;&lt;u&gt;mã tỉnh&lt;/u&gt; (VD HNI)&lt;br&gt;tên tỉnh" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="76" as="geometry"/></mxCell><mxCell id="xa" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Xã&lt;/div&gt;&lt;u&gt;mã xã&lt;/u&gt; (VD HNI035)&lt;br&gt;tên xã&lt;br&gt;mã tỉnh" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="300" height="96" as="geometry"/></mxCell><mxCell id="tram" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Trạm (eNodeB/gNodeB)&lt;/div&gt;&lt;u&gt;loại mạng + eNodeB/gNodeB ID&lt;/u&gt;&lt;br&gt;tên trạm, hãng" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="300" height="76" as="geometry"/></mxCell><mxCell id="cell" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Cell&lt;/div&gt;&lt;u&gt;loại mạng + eNodeB ID + Cell ID&lt;/u&gt;&lt;br&gt;Cell name, mã xã&lt;br&gt;kinh độ, vĩ độ" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="300" height="96" as="geometry"/></mxCell><mxCell id="mme" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;MME&lt;/div&gt;&lt;u&gt;tên MME&lt;/u&gt; (VD MMEE1A)&lt;br&gt;hãng, 2 IP, cổng 29168&lt;br&gt;site, trạng thái kết nối" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="300" height="96" as="geometry"/></mxCell><mxCell id="bt" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Bản tin&lt;/div&gt;&lt;u&gt;mã bản tin&lt;/u&gt;&lt;br&gt;chiến dịch, số công văn&lt;br&gt;chế độ (mẫu/tự do), mã mẫu&lt;br&gt;tiêu đề, nội dung&lt;br&gt;Message ID, Message Code&lt;br&gt;số lần cập nhật, Serial Number&lt;br&gt;chu kỳ lặp, thời hạn, giờ hẹn&lt;br&gt;trạng thái (8)&lt;br&gt;người soạn, người duyệt&lt;br&gt;các mốc thời gian" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="340" height="236" as="geometry"/></mxCell><mxCell id="vp" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Vùng phát bản tin&lt;/div&gt;&lt;u&gt;mã bản tin + mã xã&lt;/u&gt;&lt;br&gt;danh sách cell chốt khi phát" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="340" height="76" as="geometry"/></mxCell><mxCell id="pb" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Phiên bản nội dung&lt;/div&gt;&lt;u&gt;mã bản tin + số lần cập nhật&lt;/u&gt;&lt;br&gt;tiêu đề, nội dung, thời điểm" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="340" height="76" as="geometry"/></mxCell><mxCell id="yc" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Yêu cầu cập nhật/dừng&lt;/div&gt;&lt;u&gt;mã yêu cầu&lt;/u&gt;&lt;br&gt;mã bản tin, loại&lt;br&gt;nội dung mới, lý do&lt;br&gt;người yêu cầu, người duyệt&lt;br&gt;trạng thái" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="340" height="136" as="geometry"/></mxCell><mxCell id="ls" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Lịch sử thao tác bản tin&lt;/div&gt;mã bản tin, thời điểm&lt;br&gt;người, thao tác, ghi chú" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="420" y="900" width="340" height="76" as="geometry"/></mxCell><mxCell id="luot" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Lượt gửi lệnh&lt;/div&gt;&lt;u&gt;mã lượt&lt;/u&gt;&lt;br&gt;mã bản tin&lt;br&gt;loại lệnh&lt;br&gt;Serial Number&lt;br&gt;thời điểm, người, lý do" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="840" y="400" width="300" height="136" as="geometry"/></mxCell><mxCell id="kq" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Kết quả theo cell&lt;/div&gt;&lt;u&gt;mã lượt + Cell ID&lt;/u&gt;&lt;br&gt;kết quả (chờ/thành công/lỗi)&lt;br&gt;mã lỗi &lt;i style=&quot;color:#C05000&quot;&gt;[Cần xác nhận]&lt;/i&gt;&lt;br&gt;thời điểm phản hồi" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="840" y="640" width="300" height="116" as="geometry"/></mxCell><mxCell id="cmas" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Mức ưu tiên (CMAS)&lt;/div&gt;&lt;u&gt;Message ID chính&lt;/u&gt;&lt;br&gt;Message ID phụ&lt;br&gt;tên hiển thị, sử dụng" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="300" height="96" as="geometry"/></mxCell><mxCell id="mau" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Mẫu tin&lt;/div&gt;&lt;u&gt;mã mẫu&lt;/u&gt;&lt;br&gt;nhóm, tiêu đề, nội dung có biến&lt;br&gt;Message ID mặc định, trạng thái" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="840" y="230" width="300" height="96" as="geometry"/></mxCell><mxCell id="tk" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Tài khoản&lt;/div&gt;&lt;u&gt;mã tài khoản&lt;/u&gt;&lt;br&gt;tên đăng nhập, họ tên, đơn vị&lt;br&gt;SĐT nhận OTP, email&lt;br&gt;mật khẩu (băm), phải đổi MK&lt;br&gt;trạng thái, lý do khoá" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1240" y="80" width="300" height="136" as="geometry"/></mxCell><mxCell id="tkvt" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Tài khoản – Vai trò&lt;/div&gt;&lt;u&gt;mã tài khoản + mã vai trò&lt;/u&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1240" y="240" width="300" height="56" as="geometry"/></mxCell><mxCell id="vt" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Vai trò&lt;/div&gt;&lt;u&gt;mã vai trò&lt;/u&gt;&lt;br&gt;tên, mô tả, loại" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1240" y="330" width="300" height="76" as="geometry"/></mxCell><mxCell id="vtq" value="&lt;div style=&quot;background:#DCEBFA;margin:-8px -8px 6px;padding:6px;font-weight:bold;text-align:center&quot;&gt;Vai trò – Quyền&lt;/div&gt;&lt;u&gt;mã vai trò + mã quyền&lt;/u&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.3;align=left;verticalAlign=top;spacing=8;overf